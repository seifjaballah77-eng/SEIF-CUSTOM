<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#101522" android:fillViewport="true">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SEIF CUSTOM" android:textColor="#F4F6FF" android:textSize="24sp" android:textStyle="bold"/>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="PERSONAL DEVICE EXPERIENCE" android:textColor="#AAB7D8" android:textSize="10sp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:padding="15dp" android:background="@drawable/panel_bg" android:text="خلفيات هاتفك" android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold"/>
<TextView android:id="@+id/selectedFile" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="لم تختر خلفية بعد" android:textColor="#B8C4E0" android:textSize="13sp"/>
<Button android:id="@+id/chooseWallpaper" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="10dp" android:text="اختيار صورة أو فيديو من الهاتف" android:textColor="#FFFFFF"/>
<TextView android:id="@+id/opacityLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="وضوح الخلفية: 100%" android:textColor="#E6EAF7" android:textSize="13sp"/>
<SeekBar android:id="@+id/opacitySeek" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="85" android:progress="85"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="الوضوح للصور وGIF؛ شفافية الفيديو تعتمد على مشغّل الهاتف." android:textColor="#91A0C2" android:textSize="11sp"/>
<Button android:id="@+id/applyWallpaper" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="10dp" android:text="معاينة وتطبيق الخلفية الحية" android:textColor="#FFFFFF"/>
<Button android:id="@+id/removeWallpaper" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="6dp" android:text="إزالة اختيار الخلفية" android:textColor="#F1B8C0"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:padding="15dp" android:background="@drawable/panel_bg" android:text="مركز التطبيقات" android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold"/>
<EditText android:id="@+id/searchApps" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="12dp" android:paddingStart="14dp" android:paddingEnd="14dp" android:hint="ابحث عن تطبيق بالاسم..." android:textColor="#FFFFFF" android:textColorHint="#8997B5" android:singleLine="true" android:inputType="text"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
<Button android:id="@+id/filterVisible" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:text="الكل" android:textSize="11sp"/>
<Button android:id="@+id/filterFavorites" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:text="المفضلة" android:textSize="11sp"/>
<Button android:id="@+id/filterHidden" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:text="المخفية" android:textSize="11sp"/>
</LinearLayout>
<TextView android:id="@+id/appCount" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="التطبيقات المتاحة في المشغّل" android:textColor="#AAB7D8" android:textSize="11sp"/>
<LinearLayout android:id="@+id/appList" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="8dp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:padding="12dp" android:background="@drawable/panel_bg" android:text="ملاحظة الخصوصية: الإخفاء هنا من قائمة SEIF CUSTOM فقط. لا يخفي التطبيق من إعدادات Android أو مشغّلات أخرى أو إحصاءات وقت الشاشة." android:textColor="#D0D7E8" android:textSize="11sp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="كل التغييرات اختيارية ويمكن التراجع عنها. لا نغيّر إعدادات الطاقة أو الوضع الليلي تلقائياً." android:textColor="#8391B0" android:textSize="11sp"/>
</LinearLayout></ScrollView>